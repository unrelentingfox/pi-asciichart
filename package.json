{
  "name": "pi-asciichart",
  "version": "0.2.0",
  "description": "Pi extension that renders line charts in the tool-result UI using asciichart",
  "license": "MIT",
  "author": "Dustin Fox",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "asciichart",
    "chart",
    "ascii",
    "line-chart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unrelentingfox/pi-asciichart.git"
  },
  "homepage": "https://github.com/unrelentingfox/pi-asciichart#readme",
  "bugs": {
    "url": "https://github.com/unrelentingfox/pi-asciichart/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test __tests__/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "asciichart": "1.5.25"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/asciichart": "1.5.8",
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
